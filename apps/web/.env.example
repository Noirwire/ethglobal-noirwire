# Every value below is the local default; unset a line to use it.
# The browser never calls these services. The Next.js server reads them.

# Hedger service: GET /status and GET /events
HEDGER_URL=http://127.0.0.1:8701

# Bridge service: GET /v1/transfers
BRIDGE_URL=http://127.0.0.1:8702

# Arc RPC and the NavReceiver contract the CRE report is written to.
# Without NAV_RECEIVER_ADDRESS the proof page shows the source as not connected.
ARC_RPC_URL=http://127.0.0.1:8545
# NAV_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
# First block to scan for NavReportReceived logs
# NAV_FROM_BLOCK=0

# Optional: URL serving the published NavSnapshot JSON for the latest close.
# Without it the proof page shows only the onchain totals.
# NAV_SNAPSHOT_URL=http://127.0.0.1:8703/nav-snapshot.json

# Residual deadband in BTC. Published sizes are rounded to 0.01 BTC, so a
# smaller band cannot be told apart from zero in the public view.
# RESIDUAL_BAND_BTC=0.01
