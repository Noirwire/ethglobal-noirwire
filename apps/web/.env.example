# Every value below is the local default; unset a line to use it.
# The browser never calls these services. The Next.js server reads them.

# Hedger service: GET /status and GET /events
HEDGER_URL=http://127.0.0.1:8701

# Bridge service: GET /v1/transfers
BRIDGE_URL=http://127.0.0.1:8702
# Shared secret the bridge requires on POST routes (server-only, never NEXT_PUBLIC). Must equal the bridge's BRIDGE_API_TOKEN.
# BRIDGE_API_TOKEN=

# Arc RPC and the NavReceiver contract the CRE report is written to.
# Without NAV_RECEIVER_ADDRESS the proof page shows the source as not connected.
ARC_RPC_URL=http://127.0.0.1:8545
# NAV_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000
# First block to scan for NavReportReceived logs
# NAV_FROM_BLOCK=0

# Optional: URL serving the published NavSnapshot JSON for the latest close.
# Without it the proof page shows only the onchain totals.
# NAV_SNAPSHOT_URL=http://127.0.0.1:8703/nav-snapshot.json

# Deposit overlay, Arc door. These are read by the browser, so they are public.
# The vault address has no default; without it the Arc door says it is not configured.
# NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# NEXT_PUBLIC_SHARE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Funding from Ethereum, Base and Arbitrum testnets. Address of the HookExecutor on Arc
# that receives the CCTP mint and turns it into a vault deposit. Public; no default.
# NEXT_PUBLIC_HOOK_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
# Circle attestation service used by the server for fees and attestations (default is the testnet service).
# IRIS_API_URL=https://iris-api-sandbox.circle.com

# Trade tab in the header: URL of the separately deployed trading terminal (devnet).
# The tab is hidden when this is unset.
# NEXT_PUBLIC_TRADE_URL=https://trade.example.com

# Residual deadband in BTC. Published sizes are rounded to 0.01 BTC, so a
# smaller band cannot be told apart from zero in the public view.
# RESIDUAL_BAND_BTC=0.01
