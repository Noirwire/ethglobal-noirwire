# mock (no network, scripted demo) or testnet (Hyperliquid testnet)
HEDGER_MODE=mock
# replay (scripted or REPLAY_FILE ndjson) or tape (poll the order book API)
FILL_SOURCE=replay

# Must be exactly "0" or "1". Anything else, including empty, refuses to start.
# 0 observes only: reads fills, venue state and publishes status, places no orders.
# 1 hedges. In testnet mode HEDGE_ENABLED=1 without HL_ACCOUNT_ADDRESS and
# HL_AGENT_PRIVATE_KEY fails at start with a clear message.
# In testnet mode this variable has no default and must be set explicitly.
HEDGE_ENABLED=1

BOOK_MARKET=NBTC-PERP
HEDGE_COIN=BTC
# BOOK_API_URL=http://localhost:8700
# REPLAY_FILE=./fills.ndjson

# Master account that holds the funds (public address) and the approved agent key.
# The agent key is exported into the environment, never written to a tracked file.
# HL_ACCOUNT_ADDRESS=0x...
# HL_AGENT_PRIVATE_KEY=0x...

# Sizes are 8 decimal BTC base units.
# DEADBAND_BTC8=20000
# MAX_ORDER_BTC8=50000000
# PRICE_BAND_BPS=30
# SOFT_LIMIT_USD=2000
# HARD_LIMIT_USD=10000
# HEDGE_LEVERAGE_TARGET=4
# INITIAL_MAKER_POSITION_BTC8=0
# HTTP_PORT=8701
# KEEP_ALIVE=0
